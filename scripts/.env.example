
# LLM Configuration
# Copy this file to scripts/.env and fill in your values.
# scripts/.env is gitignored — never commit it with real credentials.

# Provider: ollama | openai | deepseek | custom
LLM_PROVIDER=ollama

# Model name (must match what your provider serves)
LLM_MODEL=llama3.1

# API base URL (leave blank to use provider default)
# Ollama default: http://localhost:11434/v1
# OpenAI default: https://api.openai.com/v1
LLM_BASE_URL=

# API key (not needed for Ollama)
LLM_API_KEY=

# Generation parameters
LLM_TIMEOUT=30
LLM_MAX_TOKENS=256
LLM_TEMPERATURE=0.7

# Per-step LLM budget: max agents that call LLM for mobility per simulation step.
# Set to 0 to disable LLM entirely (all rule-based).
# Set high (e.g., 500) to enable LLM for all agents.
LLM_CALLS_PER_STEP=50

# Mapillary API key for street view images
MAPILLARY_API_KEY=your_mapillary_key_here

# Google Street View Static API key (for PerceptionLM analysis)
GOOGLE_STREETVIEW_API_KEY=your_google_streetview_key_here

# ============================================
# URBAN ABM - ENVIRONMENT TEMPLATE
# ============================================
# Copy this file to .env and fill in your actual values
# NEVER commit .env file to git - it's already in .gitignore

# ── LLM Provider Configuration ────────────────────────────────────────
# Options: ollama (local), openai, gemini, vllm, deepseek, lmdeploy
LLM_PROVIDER=ollama
LLM_MODEL=your-model-name-here
LLM_API_KEY=your-api-key-here
LLM_BASE_URL=
LLM_TIMEOUT=60
LLM_MAX_TOKENS=256
LLM_TEMPERATURE=0.7

# ── LLM Connection Pool Settings ─────────────────────────────────────
LLM_MAX_CONNECTIONS=100
LLM_MAX_KEEPALIVE_CONNECTIONS=20
LLM_CONNECT_TIMEOUT=10

# ── LLM Circuit Breaker Settings ─────────────────────────────────────
LLM_CIRCUIT_BREAKER_THRESHOLD=5
LLM_CIRCUIT_BREAKER_RECOVERY=30

# ── API Keys ──────────────────────────────────────────────────────────
# Mapbox (get from: https://account.mapbox.com/)
MAPBOX_TOKEN=your-mapbox-token-here

# HuggingFace (get from: https://huggingface.co/settings/tokens)
HF_TOKEN=your-huggingface-token-here

# Google Gemini (get from: https://makersuite.google.com/app/apikey)
GEMINI_API_KEY=your-gemini-key-here

# OpenAI (get from: https://platform.openai.com/api-keys)
OPENAI_API_KEY=your-openai-key-here

# DeepSeek (get from: https://platform.deepseek.com/)
DEEPSEEK_API_KEY=your-deepseek-key-here

# ── Google Cloud Platform (for BigQuery) ─────────────────────────────
# Option 1: API Key (simpler)
GOOGLE_API_KEY=your-google-api-key-here

# Option 2: Service Account (recommended for production)
# Create service account: https://console.cloud.google.com/apis/credentials
GOOGLE_APPLICATION_CREDENTIALS=path/to/your/service-account-key.json
GCP_PROJECT_ID=your-gcp-project-id

# ── Agent Configuration ───────────────────────────────────────────────
# Number of agents in the simulation (1-500 recommended)
NUM_AGENTS=50

# Spawn seed for reproducible agent placement (optional)
# Leave empty or comment out for random spawning
SPAWN_SEED=

# LLM calls per step (for hybrid mode)
# 0 = all rule-based, 50 = mix, 100+ = all LLM
LLM_CALLS_PER_STEP=50

# ── Perception Mode ───────────────────────────────────────────────────
# Options: amenities, perception, both, rule_based
PERCEPTION_MODE=both

# ── Database Configuration ────────────────────────────────────────────
# DuckDB database path (relative to Backend/Agent)
DATABASE_PATH=..\Environment\eixample_overture.duckdb

# ── Overture Maps Configuration ───────────────────────────────────────
# Release version for S3 download (default: 2024-11-13.0)
OVERTURE_RELEASE=2024-11-13.0

# ── Server Configuration ──────────────────────────────────────────────
HOST=127.0.0.1
PORT=8000
RELOAD=true

# ── External Data Sources ─────────────────────────────────────────────
# Weather snapshot — uses Open-Meteo (free, no key required)
# Load via the "External Data" card in the frontend, or POST /api/external/weather/download

# Transit (GTFS) — override the auto-detected feed URL for your city
# Leave blank to auto-resolve from bbox centroid via Transitland (free)
GTFS_URL=

# Custom data source API keys (add your own here as you create new plugins)
# MY_CUSTOM_API_KEY=
